---
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, impact } from '../lib/data';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  extraSchema?: Record<string, unknown>[];
}
const { title, description, image, extraSchema = [] } = Astro.props;

const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image || '/images/brand/og-image.png'), Astro.site).href;

// Organization structured data, built from Site settings and Impact so it always
// matches the visible page (Google requires that).
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: site.chapter_name,
  alternateName: [site.short_name, 'Net Impact Kelley Undergraduate Chapter', 'Net Impact: The Sustainable Business Club', 'Environmental Business Club'],
  description: site.description,
  url: siteUrl,
  logo: new URL(url('/images/brand/logo-color-whitebg.png'), Astro.site).href,
  email: site.email,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  parentOrganization: { '@type': 'Organization', name: 'Net Impact', url: 'https://www.netimpact.org' },
  award: impact.awards.map((a) => `${a.year} ${a.name}`),
  sameAs: [site.instagram_url, site.linkedin_url].filter(Boolean),
};
const schemas = [org, ...extraSchema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0067B1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.chapter_name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.announcement && (
      <p class="announce">
        {site.announcement}
        {site.announcement_link && site.announcement_link_text && <a href={url(site.announcement_link)}>{site.announcement_link_text}</a>}
      </p>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
