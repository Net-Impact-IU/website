---
import Base from '../layouts/Base.astro';
import StatsBand from '../components/StatsBand.astro';
import EventList from '../components/EventList.astro';
import FaqList from '../components/FaqList.astro';
import Testimonials from '../components/Testimonials.astro';
import ProjectCards from '../components/ProjectCards.astro';
import JoinBanner from '../components/JoinBanner.astro';
import page from '../content/pages/home.json';
import nonprofits from '../content/pages/nonprofits.json';
import { site, upcomingEvents, approvedProjects } from '../lib/data';
import { url } from '../lib/url';

const events = (await upcomingEvents()).filter((e) => e.data.featured).slice(0, 3);
const projects = (await approvedProjects()).slice(0, 3);
---
<Base title={page.seo_title} description={page.seo_description}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="kicker">{page.kicker}</span>
        <h1>{page.headline}</h1>
        <p class="lead">{page.intro}</p>
        <p class="hero__meet">General meetings: <strong>{site.meeting_time}</strong></p>
        <div class="btn-row">
          <a class="btn btn--primary" href={url('/join/')}>Join Net Impact</a>
          <a class="btn btn--secondary" href={url('/nonprofits/')}>Work with us</a>
        </div>
      </div>
      <div class="hero__media">
        {page.hero_image ? (
          <img src={url(page.hero_image)} alt={page.hero_image_alt} width="1800" height="1200" fetchpriority="high" />
        ) : (
          <div class="placeholder hero__placeholder">Group photo goes here<br />(Page text form: Home, hero image)</div>
        )}
      </div>
    </div>
  </section>

  <StatsBand />

  <section class="section" aria-labelledby="what-title">
    <div class="container">
      <div class="section-head">
        <span class="kicker">What we do</span>
        <h2 id="what-title">Consulting, careers and community</h2>
      </div>
      <div class="grid grid--3">
        {page.pillars.map((p) => (
          <article class="card">
            <div class="card__accent" aria-hidden="true"></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a class="card__link" href={url(p.link)}>Learn more<span class="visually-hidden"> about {p.title}</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--aqua" aria-labelledby="np-title">
    <div class="container np">
      <div>
        <span class="kicker np__kicker">For nonprofits</span>
        <h2 id="np-title">{page.nonprofit_headline}</h2>
        <p>{page.nonprofit_text}</p>
        <a class="btn btn--primary" href={url('/nonprofits/')}>Request a project</a>
      </div>
      <ul class="np__services">
        {nonprofits.services.map((s) => <li>{s.name}</li>)}
      </ul>
    </div>
  </section>

  {events.length > 0 && (
    <section class="section" aria-labelledby="events-title">
      <div class="container">
        <div class="section-head"><span class="kicker">Coming up</span><h2 id="events-title">Upcoming events</h2></div>
        <EventList events={events} />
        <p class="more"><a href={url('/events/')}>See all events</a></p>
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="section section--surface" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-head"><span class="kicker">Client work</span><h2 id="projects-title">Recent projects</h2></div>
        <ProjectCards projects={projects} />
      </div>
    </section>
  )}

  <Testimonials />

  <section class="section section--surface" aria-labelledby="faq-title">
    <div class="container narrow">
      <div class="section-head"><span class="kicker">FAQ</span><h2 id="faq-title">Frequently asked questions</h2></div>
      <FaqList />
    </div>
  </section>

  <JoinBanner />
</Base>

<style>
  .hero { padding-block: clamp(var(--space-12), 7vw, var(--space-24)); background: linear-gradient(180deg, var(--color-surface) 0%, #fff 100%); }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(var(--space-8), 5vw, var(--space-16)); align-items: center; }
  .hero h1 { font-size: clamp(2.25rem, 4vw, 3.25rem); }
  .hero__meet { font-size: var(--fs-sm); margin-bottom: var(--space-6); }
  .hero__media img { border-radius: 16px; box-shadow: var(--shadow-card-hover); width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .hero__placeholder { aspect-ratio: 5 / 4; }
  .np { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-12); align-items: center; }
  .np__kicker { color: var(--color-teal); } /* small blue text on aqua is below 4.5:1 */
  .np__services { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .np__services li { background: #fff; border-radius: 10px; padding: 14px 18px; font-weight: 600; color: var(--color-teal); border-left: 4px solid var(--color-primary); }
  .more { margin-top: var(--space-6); font-weight: 600; }
  @media (max-width: 860px) {
    .hero__grid, .np { grid-template-columns: 1fr; }
  }
</style>
