---
import { url } from '../lib/url';
import { site, publishedPosts } from '../lib/data';

const posts = await publishedPosts();
const links = [
  { href: '/about/', label: 'About' },
  { href: '/programs/', label: 'Programs' },
  { href: '/nonprofits/', label: 'For Nonprofits' },
  { href: '/events/', label: 'Events' },
  ...(posts.length ? [{ href: '/news/', label: 'News' }] : []),
];
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string) => here === href || here === href.replace(/\/$/, '');
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={url('/')}>
      <img src={url('/images/brand/logo-color.svg')} alt={`${site.chapter_name} Undergrad, home`} width="210" height="85" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary site-nav__cta" href={url('/join/')}>Join</a>
    </nav>

    <!-- Mobile menu: works without JavaScript -->
    <details class="mobile-nav">
      <summary aria-label="Menu"><span class="mobile-nav__bars" aria-hidden="true"></span>Menu</summary>
      <ul>
        {links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
        <li><a class="btn btn--primary" href={url('/join/')}>Join Net Impact</a></li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--color-border); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); min-height: 92px; }
  .site-header__logo img { width: 210px; height: auto; }
  .site-nav { display: flex; align-items: center; gap: var(--space-6); }
  .site-nav ul { display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  .site-nav ul a { color: #3f4a3a; font-weight: 500; font-size: var(--fs-sm); text-decoration: none; position: relative; display: inline-flex; align-items: center; min-height: 44px; }
  .site-nav ul a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 6px; height: 2px; background: var(--color-primary); transform: scaleX(0); transform-origin: left; transition: transform var(--duration-base) var(--ease-out); }
  .site-nav ul a:hover, .site-nav ul a[aria-current='page'] { color: var(--color-primary); }
  .site-nav ul a:hover::after, .site-nav ul a[aria-current='page']::after { transform: scaleX(1); }
  .site-nav__cta { padding: 10px 22px; }

  .mobile-nav { display: none; position: relative; }
  .mobile-nav summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px; font-weight: 600; color: var(--color-primary); padding: 10px 4px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav__bars, .mobile-nav__bars::before, .mobile-nav__bars::after { display: block; width: 20px; height: 2px; background: currentColor; position: relative; }
  .mobile-nav__bars::before, .mobile-nav__bars::after { content: ''; position: absolute; left: 0; }
  .mobile-nav__bars::before { top: -6px; }
  .mobile-nav__bars::after { top: 6px; }
  .mobile-nav ul { position: absolute; right: 0; top: calc(100% + 8px); background: #fff; list-style: none; margin: 0; padding: var(--space-4); border-radius: var(--radius-card); box-shadow: var(--shadow-card-hover); min-width: 230px; display: grid; gap: var(--space-2); }
  .mobile-nav ul a:not(.btn) { display: block; padding: 10px 8px; color: var(--color-text); text-decoration: none; font-weight: 500; }
  .mobile-nav ul .btn { width: 100%; margin-top: var(--space-2); }

  @media (max-width: 900px) {
    .site-nav { display: none; }
    .mobile-nav { display: block; }
    .site-header__inner { min-height: 76px; }
    .site-header__logo img { width: 200px; }
  }
</style>
