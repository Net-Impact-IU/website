---
import type { SiteEvent } from '../lib/data';
interface Props { events: SiteEvent[]; emptyText?: string }
const { events, emptyText } = Astro.props;
---
{events.length === 0 ? (
  <p class="events-empty">{emptyText}</p>
) : (
  <ul class="events">
    {events.map((e) => (
      <li class="event">
        <div class="event__date" aria-hidden="true"><span>{e.month}</span><strong>{e.day}</strong></div>
        <div class="event__body">
          <h3>{e.title}</h3>
          <p class="event__meta">
            <span class="visually-hidden">{e.long}. </span>
            {[e.time, e.location].filter(Boolean).join(' · ')}
          </p>
          {e.description && <p>{e.description}</p>}
          <p class="event__cal"><a href={e.calendarUrl} rel="noopener">Add to Google Calendar<span class="visually-hidden">: {e.title}</span></a></p>
        </div>
        {e.link && <a class="btn btn--secondary event__cta" href={e.link} rel="noopener">{e.linkLabel}<span class="visually-hidden">: {e.title}</span></a>}
      </li>
    ))}
  </ul>
)}
<style>
  .events { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .event { display: grid; grid-template-columns: 72px 1fr auto; gap: var(--space-6); align-items: center; background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); padding: var(--space-6); }
  .event__date { background: var(--color-primary); color: #fff; border-radius: 10px; text-align: center; padding: 8px 0; }
  .event__date span { display: block; font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
  .event__date strong { display: block; font-family: var(--font-display); font-size: 1.75rem; line-height: 1.1; }
  .event__body h3 { margin-bottom: 4px; }
  .event__body p { margin: 0; }
  .event__cal { font-size: var(--fs-sm); font-weight: 600; }
  .event__cal a { display: inline-block; padding-block: 11px; }
  .event__meta { font-size: var(--fs-sm); font-weight: 500; }
  .events-empty { padding: var(--space-6); background: var(--color-surface); border-radius: var(--radius-card); margin: 0; }
  @media (max-width: 640px) { .event { grid-template-columns: 60px 1fr; } .event__cta { grid-column: 1 / -1; } }
</style>
